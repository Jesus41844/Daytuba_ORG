# --- Base de datos (PostgreSQL en Supabase) ---
# Dev y producción usan la misma base. Trae el valor con `vercel env pull` o
# cópialo del dashboard (Project Settings → Database → Connection string).
#   App:         transaction pooler, puerto 6543
#   Migraciones: session pooler (5432) o conexión directa — el transaction
#                pooler no soporta lo que necesita drizzle-kit.
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# --- Archivos (PDFs adjuntos y fotos de perfil) ---
# Los archivos se guardan en Vercel Blob. Crea tu store con:
#   vercel blob create-store daytuba-uploads --access public --yes
# y trae las variables con `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
VERCEL_OIDC_TOKEN=

# --- Moodle sync ---
MOODLE_ENCRYPTION_KEY=

# --- Docker Compose (producción) ---
# Copia este archivo a .env y completa antes de `docker compose up`
POSTGRES_USER=utp
POSTGRES_PASSWORD=
POSTGRES_DB=utp_tasks
WEB_PORT=3000

# --- Cron de recordatorios y sync de Moodle (producción) ---
# Lo usa el sidecar "cron" de docker-compose y los endpoints
# /api/cron/reminders y /api/cron/moodle-sync.
# Genera una con: openssl rand -hex 24
CRON_SECRET=
# Horario del barrido diario en UTC. El default (0 14 * * *) es 09:00 en
# Panamá (UTC-5, sin horario de verano). Sin DST.
REMINDERS_CRON_SCHEDULE=0 14 * * *
# Horario del sync automático de Moodle (todos los usuarios) en UTC. El
# default (0 11 * * *) es 06:00 en Panamá, antes del barrido de recordatorios.
MOODLE_SYNC_CRON_SCHEDULE=0 11 * * *
