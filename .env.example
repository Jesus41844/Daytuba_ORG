# --- Base de datos (PostgreSQL) ---
# Desarrollo: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://utp:utp@localhost:5433/utp_tasks

# --- Archivos (PDFs adjuntos y fotos de perfil) ---
# Los archivos se guardan en Vercel Blob. Crea tu store con:
#   vercel blob create-store daytuba-uploads --access public --yes
# y trae las variables con `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
VERCEL_OIDC_TOKEN=

# --- Moodle sync ---
MOODLE_ENCRYPTION_KEY=

# --- Docker Compose (producción) ---
# Copia este archivo a .env y completa antes de `docker compose up`
POSTGRES_USER=utp
POSTGRES_PASSWORD=
POSTGRES_DB=utp_tasks
WEB_PORT=3000
